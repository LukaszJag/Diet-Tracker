<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <!-- Month Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/calPrevMonthButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="&lt;"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calMonthYearTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="November 2026"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/calNextMonthButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="&gt;"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Weekday Headers (Mon to Sun, with Sunday in Dark Red) -->
    <LinearLayout
        android:id="@+id/calWeekdayHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="7">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Mon" android:textSize="11sp" android:textStyle="bold" android:textColor="#555555"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Tue" android:textSize="11sp" android:textStyle="bold" android:textColor="#555555"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Wed" android:textSize="11sp" android:textStyle="bold" android:textColor="#555555"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Thu" android:textSize="11sp" android:textStyle="bold" android:textColor="#555555"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Fri" android:textSize="11sp" android:textStyle="bold" android:textColor="#555555"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sat" android:textSize="11sp" android:textStyle="bold" android:textColor="#555555"/>
        <!-- Sunday with Dark Red Color (#8B0000) -->
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sun" android:textSize="11sp" android:textStyle="bold" android:textColor="#8B0000"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"/>

    <!-- Days Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calDaysRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never" />

    <!-- Status summary -->
    <TextView
        android:id="@+id/calSelectedCountTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No days selected (Showing all notes)"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginTop="6dp"/>

    <!-- Bottom Buttons: Uncheck all days & Apply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/calBtnUncheckAll"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Uncheck all days"
            android:textSize="11sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/calBtnApply"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Apply Filter"
            android:textSize="11sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>