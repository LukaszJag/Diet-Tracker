            greenMarkerValueMarker.setLabelAnchor(RectangleAnchor.TOP_LEFT);
            greenMarkerValueMarker.setLabelTextAnchor(TextAnchor.BOTTOM_LEFT);
            //</editor-fold>

            //<editor-fold desc="yellowMarkerValueMarker">
