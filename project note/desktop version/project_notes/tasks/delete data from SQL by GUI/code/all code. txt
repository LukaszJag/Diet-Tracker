                if (unsyncedCount == 0) {
                    System.out.println("\nSuccess! All rows have been synchronized to Azure SQL.");
                    break;
                }

                // Wait 3 seconds before checking the database status again
                Thread.sleep(3000);
            }
        } catch (Exception e) {
            System.err.println("Progress monitor error: " + e.getMessage());
        }
    }
