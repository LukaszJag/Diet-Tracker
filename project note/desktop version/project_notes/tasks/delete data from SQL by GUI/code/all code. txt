            redMarkerValueMarker.setLabel(String.valueOf(redMarker));
            redMarkerValueMarker.setLabelAnchor(RectangleAnchor.TOP_LEFT);
            redMarkerValueMarker.setLabelTextAnchor(TextAnchor.BOTTOM_LEFT);


