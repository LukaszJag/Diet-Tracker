<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RGB color picker"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="16dp" />

        <!-- Sekcja Color Pickera (Kwadrat + Pasek + Pola numeryczne) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="horizontal">

            <!-- 1. Kwadrat Saturation/Value -->
            <com.lukaszjag.diet_tracker_android.tools.widget.ColorSatValView
                android:id="@+id/satValPicker"
                android:layout_width="150dp"
                android:layout_height="match_parent" />

            <!-- 2. Pionowy pasek barwy Hue -->
            <com.lukaszjag.diet_tracker_android.tools.widget.ColorHueBarView
                android:id="@+id/huePicker"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp" />

            <!-- 3. Podgląd koloru i wartości R, G, B, H, S, V, Hex -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Podgląd aktualnego koloru -->
                <ImageView
                    android:id="@+id/colorPreview"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <!-- Pola R i H -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="R" android:textStyle="bold"/>
                    <EditText android:id="@+id/etR" android:layout_width="45dp" android:layout_height="36dp" android:textSize="12sp" android:inputType="number" android:text="255"/>
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="H" android:textStyle="bold"/>
                    <EditText android:id="@+id/etH" android:layout_width="45dp" android:layout_height="36dp" android:textSize="12sp" android:inputType="number" android:text="0"/>
                </LinearLayout>

                <!-- Pola G i S -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="G" android:textStyle="bold"/>
                    <EditText android:id="@+id/etG" android:layout_width="45dp" android:layout_height="36dp" android:textSize="12sp" android:inputType="number" android:text="255"/>
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="S" android:textStyle="bold"/>
                    <EditText android:id="@+id/etS" android:layout_width="45dp" android:layout_height="36dp" android:textSize="12sp" android:inputType="number" android:text="0"/>
                </LinearLayout>

                <!-- Pola B i V -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="B" android:textStyle="bold"/>
                    <EditText android:id="@+id/etB" android:layout_width="45dp" android:layout_height="36dp" android:textSize="12sp" android:inputType="number" android:text="255"/>
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="V" android:textStyle="bold"/>
                    <EditText android:id="@+id/etV" android:layout_width="45dp" android:layout_height="36dp" android:textSize="12sp" android:inputType="number" android:text="100"/>
                </LinearLayout>

                <!-- Pole HEX -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="# " android:textStyle="bold"/>
                    <EditText android:id="@+id/etHex" android:layout_width="90dp" android:layout_height="36dp" android:textSize="12sp" android:text="FFFFFF" android:textAllCaps="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Szybkie szablony kolorów (Presets) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Popular presets:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:textColor="#555555" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/presetWhite" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#FFFFFF" android:text="White" android:textColor="#000" style="?android:attr/buttonStyleSmall"/>
            <Button android:id="@+id/presetDark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#252525" android:text="Dark" android:textColor="#FFF" style="?android:attr/buttonStyleSmall"/>
            <Button android:id="@+id/presetAmoled" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#000000" android:text="Black" android:textColor="#FFF" style="?android:attr/buttonStyleSmall"/>
            <Button android:id="@+id/presetBlue" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#1E3A8A" android:text="Blue" android:textColor="#FFF" style="?android:attr/buttonStyleSmall"/>
        </LinearLayout>

        <!-- Przycisk Zapisz i zastosuj -->
        <Button
            android:id="@+id/saveColorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Background Color to Widget"
            android:layout_marginTop="24dp"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>