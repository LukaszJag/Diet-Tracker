<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/cpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Color"
        android:textColor="#222222"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="horizontal">

        <com.lukaszjag.diet_tracker_android.tools.widget.ColorSatValView
            android:id="@+id/cpSatValPicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.lukaszjag.diet_tracker_android.tools.widget.ColorHueBarView
            android:id="@+id/cpHuePicker"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Preview + HEX Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <View
            android:id="@+id/cpColorPreview"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="#EEEEEE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="#"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/cpEtHex"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:maxLength="6"
            android:text="EEEEEE"
            android:textAllCaps="true"
            android:textSize="13sp"
            android:inputType="textNoSuggestions" />
    </LinearLayout>

    <!-- Quick Note-Friendly Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Presets:"
        android:textSize="12sp"
        android:textColor="#555555"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal">

        <View android:id="@+id/cpPresetDefault" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#EEEEEE" />
        <View android:id="@+id/cpPresetBlue"    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#E3F2FD" />
        <View android:id="@+id/cpPresetGreen"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#E8F5E9" />
        <View android:id="@+id/cpPresetYellow"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#FFFDE7" />
        <View android:id="@+id/cpPresetOrange"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#FFF3E0" />
        <View android:id="@+id/cpPresetPurple"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#F3E5F5" />
        <View android:id="@+id/cpPresetRed"     android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFEBEE" />
    </LinearLayout>

</LinearLayout>