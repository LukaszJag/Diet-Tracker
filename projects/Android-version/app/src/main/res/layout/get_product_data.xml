<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/getProductFromDatabase"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="63dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="69dp"
        android:text="Get product from Azure SQL"
        app:layout_constraintBottom_toBottomOf="@+id/previousButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/productNameEditText"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/productNameEditText"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="63dp"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="58dp"
        android:height="60dp"
        android:ems="10"
        android:inputType="text"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@+id/previousButton"
        app:layout_constraintEnd_toStartOf="@+id/getProductFromDatabase"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/getProductDataRecyclerView"
        android:layout_width="44dp"
        android:layout_height="183dp"
        android:layout_marginTop="73dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/carbsValueTextView" />


    <TextView
        android:id="@+id/kcalValueTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="TextView"
        app:layout_constraintStart_toStartOf="@+id/brandValueTextView"
        app:layout_constraintTop_toBottomOf="@+id/brandValueTextView" />

    <TextView
        android:id="@+id/fatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="fat"
        app:layout_constraintStart_toStartOf="@+id/proteinLabel"
        app:layout_constraintTop_toBottomOf="@+id/proteinLabel" />

    <TextView
        android:id="@+id/carbsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="carbs"
        app:layout_constraintStart_toStartOf="@+id/fatLabel"
        app:layout_constraintTop_toBottomOf="@+id/fatLabel" />

    <TextView
        android:id="@+id/brandLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginTop="65dp"
        android:text="brand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productNameTextView" />

    <TextView
        android:id="@+id/fatValueTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="TextView"
        app:layout_constraintStart_toStartOf="@+id/proteinValueTextView"
        app:layout_constraintTop_toBottomOf="@+id/proteinValueTextView" />

    <TextView
        android:id="@+id/proteinLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="protein"
        app:layout_constraintStart_toStartOf="@+id/kcalLabel"
        app:layout_constraintTop_toBottomOf="@+id/kcalLabel" />

    <TextView
        android:id="@+id/kcalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="kcal"
        app:layout_constraintStart_toStartOf="@+id/brandLabel"
        app:layout_constraintTop_toBottomOf="@+id/brandLabel" />

    <TextView
        android:id="@+id/proteinValueTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="TextView"
        app:layout_constraintStart_toStartOf="@+id/kcalValueTextView"
        app:layout_constraintTop_toBottomOf="@+id/kcalValueTextView" />

    <TextView
        android:id="@+id/carbsValueTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="TextView"
        app:layout_constraintStart_toStartOf="@+id/fatValueTextView"
        app:layout_constraintTop_toBottomOf="@+id/fatValueTextView" />

    <TextView
        android:id="@+id/brandValueTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="63dp"
        android:text="TextView"
        app:layout_constraintStart_toEndOf="@+id/brandLabel"
        app:layout_constraintTop_toTopOf="@+id/brandLabel" />

    <TextView
        android:id="@+id/productNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="49dp"
        android:text="product name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/previousButton" />

    <Button
        android:id="@+id/previousButton"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="186dp"
        android:layout_marginEnd="14dp"
        android:text="previous"
        android:textSize="8sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/nextButton"
        app:layout_constraintEnd_toStartOf="@+id/nextButton"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="18dp"
        android:text="next"
        android:textSize="8sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/previousButton"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>